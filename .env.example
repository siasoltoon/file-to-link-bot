# Telegram bot
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OWNER_TELEGRAM_ID=

# Local Bot API. Keep these private; do not expose port 8081 publicly.
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_FILE_BASE_URL=http://telegram-bot-api:8081/file/bot

# Public HTTPS/HTTP base URL used in stable download links.
PUBLIC_BASE_URL=https://your-domain.example

# S3-compatible object storage
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Lifecycle and resource controls
DEFAULT_FILE_TTL_DAYS=30
MAX_FILE_SIZE_MB=2000
CLEANUP_INTERVAL_SECONDS=3600
PRESIGNED_URL_TTL_SECONDS=300
MAX_CONCURRENT_UPLOADS=1

# Database
DATABASE_URL=sqlite:///./data/app.db

# Optional application bind settings
APP_HOST=0.0.0.0
APP_PORT=8000
