BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OWNER_TELEGRAM_ID=

# Direct download links are generated from the S3-compatible storage itself.
# 604800 seconds = 7 days (maximum commonly supported by SigV4 presigned URLs).
DIRECT_LINK_EXPIRES_SECONDS=604800
MAX_FILE_BYTES=2000000000

# Fil One / S3-compatible storage
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Legacy Docker/API settings kept only for compatibility with the older deployment.
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_FILE_BASE_URL=http://telegram-bot-api:8081/file/bot
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./data/app.db
APP_HOST=0.0.0.0
APP_PORT=8000
