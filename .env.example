BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OWNER_TELEGRAM_ID=

# Direct download links are generated from S3-compatible storage.
# 604800 seconds = 7 days (maximum for SigV4 presigned URLs).
DIRECT_LINK_EXPIRES_SECONDS=604800
# Non-owner files are removed after this many days.
DEFAULT_FILE_TTL_DAYS=30
MAX_FILE_BYTES=2000000000

# Fil.one storage. Choose the same region used when creating the bucket/API key.
# EU (France): eu-west-1
# US East (Michigan): us-east-1
# The endpoint is derived automatically from S3_REGION; normally leave it unset.
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Legacy Docker/API settings kept only for compatibility with the older deployment.
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_FILE_BASE_URL=http://telegram-bot-api:8081/file/bot
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./data/app.db
APP_HOST=0.0.0.0
APP_PORT=8000
