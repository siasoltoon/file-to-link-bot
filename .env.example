BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OWNER_TELEGRAM_ID=

# Local Bot API URL. Keep this private on Oracle.
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_FILE_BASE_URL=http://telegram-bot-api:8081/file/bot

# Public HTTPS base URL used in stable download links.
PUBLIC_BASE_URL=https://your-domain.example

# Fil One / S3-compatible storage
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Non-owner files are deleted after this many days.
DEFAULT_FILE_TTL_DAYS=30

DATABASE_URL=sqlite:///./data/app.db

# Optional: application bind settings
APP_HOST=0.0.0.0
APP_PORT=8000
